{
  "version": 1,
  "widgets": [
    {
      "type": "bookmarks",
      "title": "즐겨찾기",
      "description": "자주 방문하는 HTTPS 링크",
      "configVersion": 1,
      "capabilities": [
        "local",
        "editable"
      ],
      "configSchema": {
        "additionalProperties": false,
        "properties": {
          "links": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "title": {
                  "maxLength": 100,
                  "type": "string"
                },
                "url": {
                  "maxLength": 2048,
                  "type": "string"
                }
              },
              "required": [
                "title",
                "url"
              ],
              "type": "object"
            },
            "maxItems": 20,
            "type": "array"
          }
        },
        "required": [
          "links"
        ],
        "type": "object"
      }
    },
    {
      "type": "calendar",
      "title": "캘린더",
      "description": "이번 달의 날짜",
      "configVersion": 1,
      "capabilities": [
        "local",
        "time"
      ],
      "configSchema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      }
    },
    {
      "type": "clock",
      "title": "세계 시계",
      "description": "원하는 시간대의 현재 시각",
      "configVersion": 1,
      "capabilities": [
        "local",
        "time"
      ],
      "configSchema": {
        "additionalProperties": false,
        "properties": {
          "timezone": {
            "maxLength": 100,
            "type": "string"
          }
        },
        "required": [
          "timezone"
        ],
        "type": "object"
      }
    },
    {
      "type": "github",
      "title": "GitHub",
      "description": "저장소·릴리스·열린 이슈와 PR",
      "configVersion": 1,
      "sourceType": "github",
      "capabilities": [
        "remote",
        "reading"
      ],
      "configSchema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "limit"
        ],
        "type": "object"
      }
    },
    {
      "type": "note",
      "title": "메모",
      "description": "오늘 기억할 내용을 내 서버에 보관",
      "configVersion": 1,
      "capabilities": [
        "local",
        "editable"
      ],
      "configSchema": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "maxLength": 12000,
            "type": "string"
          }
        },
        "required": [
          "body"
        ],
        "type": "object"
      }
    },
    {
      "type": "rss",
      "title": "RSS 소식",
      "description": "RSS·Atom 피드를 한눈에",
      "configVersion": 1,
      "sourceType": "rss",
      "capabilities": [
        "remote",
        "reading"
      ],
      "configSchema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "limit"
        ],
        "type": "object"
      }
    },
    {
      "type": "weather",
      "title": "날씨",
      "description": "Open-Meteo의 현재 날씨",
      "configVersion": 1,
      "sourceType": "weather",
      "capabilities": [
        "remote"
      ],
      "configSchema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      }
    }
  ],
  "providers": [
    {
      "type": "github",
      "title": "GitHub 저장소",
      "configVersion": 1,
      "freshForSeconds": 600,
      "capabilities": [
        "public-https"
      ],
      "configSchema": {
        "additionalProperties": false,
        "properties": {
          "repository": {
            "maxLength": 140,
            "type": "string"
          },
          "view": {
            "enum": [
              "repository",
              "releases",
              "issues",
              "pulls"
            ],
            "type": "string"
          }
        },
        "required": [
          "repository",
          "view"
        ],
        "type": "object"
      }
    },
    {
      "type": "rss",
      "title": "공개 RSS·Atom",
      "configVersion": 1,
      "freshForSeconds": 600,
      "capabilities": [
        "public-https"
      ],
      "configSchema": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "maxLength": 2048,
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      }
    },
    {
      "type": "weather",
      "title": "Open-Meteo",
      "configVersion": 1,
      "freshForSeconds": 900,
      "capabilities": [
        "public-https"
      ],
      "configSchema": {
        "additionalProperties": false,
        "properties": {
          "latitude": {
            "maximum": 90,
            "minimum": -90,
            "type": "number"
          },
          "location": {
            "maxLength": 100,
            "type": "string"
          },
          "longitude": {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          },
          "timezone": {
            "maxLength": 100,
            "type": "string"
          },
          "units": {
            "enum": [
              "celsius",
              "fahrenheit"
            ],
            "type": "string"
          }
        },
        "required": [
          "latitude",
          "longitude",
          "location"
        ],
        "type": "object"
      }
    }
  ]
}
