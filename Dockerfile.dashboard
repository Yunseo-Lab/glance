# syntax=docker/dockerfile:1
FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS frontend
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    npm ci --strict-ssl=true --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM golang:1.27.3-bookworm@sha256:972b4110ba0f47539a975c31e52c64765e1ff19f2d74469ae4a595c6676e80a5 AS backend
WORKDIR /src
ENV CGO_ENABLED=1 GOTOOLCHAIN=local GOMAXPROCS=4
COPY go.mod go.sum ./
RUN --mount=type=secret,id=system_ca \
    if [ -f /run/secrets/system_ca ]; then export SSL_CERT_FILE=/run/secrets/system_ca; fi; \
    go mod download && go mod verify
COPY main.go ./
COPY internal/ internal/
COPY pkg/ pkg/
COPY --from=frontend /src/internal/dashboard/ui/dist/ internal/dashboard/ui/dist/
RUN go build -tags sqlite_fts5 -mod=readonly -p=4 -trimpath -ldflags="-s -w" -o /out/glance .

FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
WORKDIR /app
COPY --from=backend /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=backend /out/glance /app/glance
RUN mkdir -p /app/data /app/backups && chown 10001:10001 /app/data /app/backups
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 CMD ["/app/glance", "dashboard", "healthcheck"]
ENTRYPOINT ["/app/glance"]
CMD ["dashboard", "--listen", "0.0.0.0:8080", "--db", "/app/data/dashboard.db"]
