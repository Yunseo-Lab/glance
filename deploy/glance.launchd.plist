<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
 <key>Label</key><string>lab.glance.dashboard</string>
 <key>ProgramArguments</key><array><string>/ABSOLUTE/PATH/glance/build/glance</string><string>dashboard</string><string>--listen</string><string>127.0.0.1:8090</string><string>--db</string><string>/ABSOLUTE/PATH/glance/data/dashboard.db</string></array>
 <key>EnvironmentVariables</key><dict><key>GLANCE_DASHBOARD_TOKEN_FILE</key><string>/ABSOLUTE/PATH/glance/.secrets/owner_password</string></dict>
 <key>RunAtLoad</key><true/>
 <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
 <key>ThrottleInterval</key><integer>10</integer>
 <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/glance</string>
 <key>StandardOutPath</key><string>/ABSOLUTE/USER/LOGS/glance.log</string>
 <key>StandardErrorPath</key><string>/ABSOLUTE/USER/LOGS/glance-error.log</string>
</dict></plist>
